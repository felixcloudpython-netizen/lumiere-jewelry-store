DATABASE_URL="postgresql://user:pass@localhost:5432/db?schema=public"
JWT_SECRET="change-me-min-32-chars-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
CLIENT_URL="http://localhost:3000"

# Stripe (dùng key test khi phát triển local: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary (dashboard.cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="your-key"
CLOUDINARY_API_SECRET="your-secret"

# Resend (resend.com/api-keys)
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@your-domain.com"

# Chỉ dùng cho `npm run db:seed` ở local/dev. Ở production, ĐỪNG set 2 biến này —
# hãy tự đăng ký tài khoản qua /api/auth/register rồi chạy
# `npm run db:promote-admin -- your-email@example.com` (xem prisma/promoteAdmin.ts).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
